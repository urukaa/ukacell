{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ukacell",
  "version": "0.1.0",
  "identifier": "dev.ukacell.host",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ukacell",
        "width": 420,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Mobile dev companion for Tauri v2 apps",
    "longDescription": "Ukacell loads your Tauri v2 frontend from a local dev server and gives it 20 bundled native plugins, so you can try hardware APIs on a real phone without rebuilding a native app.",
    "copyright": "Copyright (c) 2026 Ukacell contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["ukacell"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["ukacell"]
      }
    }
  }
}
