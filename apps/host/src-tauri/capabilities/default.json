{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Ukacell launcher UI bundled in ../src (QR scanning, deep links, opening the project page in the browser).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "barcode-scanner:default",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-request-permissions",
    "deep-link:default",
    "notification:allow-is-permission-granted",
    "opener:default"
  ]
}
